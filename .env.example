# Copy to .env (never commit .env). Values below are placeholders.

# --- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public address of the website (no trailing slash). Needed for unsubscribe links in emails.
PUBLIC_SITE_URL=https://your-domain.example
# Long random string (32+ characters). Signs admin sessions.   e.g.  openssl rand -hex 32
SESSION_SECRET=
# Secret path of the admin (not linked anywhere on the website). Pick something hard to guess.
ADMIN_PATH=/choose-a-private-path
# Set to the number of proxies in front of the app (e.g. 1 on most hosts) so rate limits see real visitor IPs.
TRUST_PROXY=1

# --- Database (PostgreSQL) ------------------------------------------------
DATABASE_URL=

# --- Email (ZeptoMail) ----------------------------------------------------
ZEPTO_MAIL_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Consciousness Calling
MAIL_REPLY_TO=
# SAFETY SWITCH. Email is only sent when this is exactly "true". Leave it off until you are ready.
EMAIL_SENDING_ENABLED=false

# --- File storage (S3-compatible bucket) ------------------------------------
BUCKET_REGION_ENDPOINT=
BUCKET_NAME=
BUCKET_KEY=
BUCKET_SECRET=
BUCKET_DEFAULT_ACL=public-read
BUCKET_ENDPOINT_BASE_URL=
BUCKET_CANONICAL_URL=
# Folder (prefix) inside the bucket reserved for this website
STORAGE_PREFIX=raghuveera-website
# After running "npm run upload-site-images -- --apply", set to true to serve the site's own images from the CDN
SITE_IMAGES_ON_CDN=false
